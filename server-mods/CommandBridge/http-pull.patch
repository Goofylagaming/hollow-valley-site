+        if os.time() - httpLastErrorAt >= 30 then
+            httpLastErrorAt = os.time()
+            log("HTTP input unavailable: ExecuteAsync is missing")
+        end
+        return
+    end
+    httpFetchBusy = true
+    ExecuteAsync(function()
+        local body, err = curlGet(config.inputUrl, config.inputAuthHeader)
+        if body ~= nil then
