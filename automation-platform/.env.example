PORT=3100
NODE_ENV=development

# Protect every API that can perform or inspect privileged game actions.
# Use a long random value and store the real secret only in the host's env settings.
AUTOMATION_ADMIN_TOKEN=

# Local automation request/job/audit/state database (Node 22 built-in SQLite).
# On Render, point this at a persistent disk before production use.
AUTOMATION_DB_PATH=./data/automation.sqlite
# Persisted scheduler checks for due jobs on this cadence.
AUTOMATION_SCHEDULER_INTERVAL_MS=300000

# Optional consistent SQLite snapshots. Leave disabled until persistent storage
# is verified. Restore remains a manual operator procedure.
AUTOMATION_BACKUP_ENABLED=false
AUTOMATION_BACKUP_DIR=./data/backups
AUTOMATION_BACKUP_INTERVAL_MS=21600000
AUTOMATION_BACKUP_RETENTION=20

# Evrima / RCON (same names as the live Hollow Valley service)
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
RCON_TIMEOUT_MS=6000
# Emergency isolation switch. true blocks all automation RCON reads and writes without removing credentials.
RCON_DISABLED=false
# Quiet-mode baseline: reuse one RCON snapshot for five minutes.
# Explicit manual actions may still force a fresh check when needed.
RCON_STATUS_CACHE_MS=300000
MAX_PLAYERS=100
# Legacy all-writes switch. Keep false when using the safer per-action gates below.
RCON_WRITE_ENABLED=false
# Enable only the reviewed actions. These override the legacy gate when set.
RCON_ANNOUNCEMENT_WRITE_ENABLED=false
RCON_DIRECT_MESSAGE_WRITE_ENABLED=false
RCON_CORPSE_WIPE_WRITE_ENABLED=false
RCON_SAVE_WRITE_ENABLED=false
RCON_AI_DENSITY_WRITE_ENABLED=false

# Authoritative combat event ingestion. Keep disabled until a trusted game-side
# source can emit stable unique event IDs. This token belongs only on that source
# and the automation service; never expose it to the website or browser.
COMBAT_FEED_ENABLED=false
COMBAT_FEED_TOKEN=
COMBAT_FEED_SOURCE=hollow-valley-game

# Optional read-only player presence/session history from the automation service's
# own RCON polling. Keep false when BinaryLane is the authoritative local scanner.
PLAYER_PRESENCE_ENABLED=false
PLAYER_PRESENCE_INTERVAL_MS=300000
# Dedicated BinaryLane -> automation HTTPS presence feed. Setting this token enables
# external presence tracking without exposing game RCON to the internet.
# Use a long random secret that exists only on BinaryLane and the automation service.
PRESENCE_FEED_TOKEN=
# Treat an external snapshot as live for this many seconds. The BinaryLane sender
# currently posts once per minute, so 180 seconds tolerates brief scheduler delays
# without ever painting old coordinates indefinitely.
PRESENCE_FEED_MAX_AGE_SECONDS=180
# Aggregate player-count/species samples are retained for trend analytics.
PLAYER_PRESENCE_RETENTION_HOURS=744
# Optional one-shot RCON welcome announcement for newly detected joins.
# The first successful snapshot after a service restart is only used as a baseline,
# so existing players are not re-welcomed. {player} is replaced with the player name.
JOIN_MESSAGE_ENABLED=false
JOIN_MESSAGE_TEMPLATE=Welcome to Hollow Valley, {player}! Join us at discord.gg/herbydeathsquadgames

# Valley Coin playtime rewards. These are intentionally disabled and set to 0
# until the economy rate has been explicitly chosen. Rewards are credited only
# from successful presence samples; long RCON/offline gaps are not back-paid.
WALLET_PLAYTIME_REWARDS_ENABLED=false
WALLET_PLAYTIME_COINS_PER_5_MINUTES=0
WALLET_PLAYTIME_MAX_SAMPLE_GAP_SECONDS=600

# Paid supporter multiplier applied after quest boosts. Membership entitlement
# is refreshed from the Hollow Valley website in one batch per presence sample.
# Active/trialing only: Valley Supporter ×2, Valley Guardian ×3, Valley Legend ×5.
SUPPORTER_COIN_BONUSES_ENABLED=false
SUPPORTER_MEMBERSHIP_TIMEOUT_MS=5000

# Manual/admin event rewards. These are supporter-multiplied eligible rewards,
# but remain locked until event payout policy has been reviewed.
EVENT_REWARDS_ENABLED=false

# Automatic verified-playtime quest boosts. Percentages stack additively across
# completed daily/weekly quests and apply only to future 5-minute payouts.
ECONOMY_TIMEZONE=Australia/Brisbane
WALLET_QUEST_DAILY_1H_BOOST_PERCENT=5
WALLET_QUEST_DAILY_3H_BOOST_PERCENT=10
WALLET_QUEST_DAILY_6H_BOOST_PERCENT=15
WALLET_QUEST_WEEKLY_12H_BOOST_PERCENT=10
WALLET_QUEST_WEEKLY_24H_BOOST_PERCENT=20
WALLET_QUEST_MAX_TOTAL_BOOST_PERCENT=100

# Marketplace and parked-dino customization writes are separately gated.
# Keep all false until the isolated service has passed controlled FTP testing.
MARKETPLACE_WRITE_ENABLED=false
MARKETPLACE_RECONCILE_INTERVAL_MS=300000
# Official catalog orders create real minimal DinoStorage slots only when this
# separate gate is enabled. Keep false until FTP fulfillment is controlled-tested.
OFFICIAL_MARKETPLACE_FULFILLMENT_ENABLED=false
OFFICIAL_MARKETPLACE_FULFILLMENT_INTERVAL_MS=300000
PARKED_DINO_EDIT_ENABLED=false
SKIN_SYSTEM_ENABLED=false
SKIN_PRESET_CREATE_COST=500
# Live skin application is separately gated and remains off by default.
SKIN_LIVE_WEAR_ENABLED=false
SKIN_WEAR_TIMEOUT_MS=12000

# Optional read-only health history for uptime/player-count analytics.
SERVER_HEALTH_HISTORY_ENABLED=false
SERVER_HEALTH_HISTORY_INTERVAL_MS=300000
SERVER_HEALTH_HISTORY_RETENTION_HOURS=720

# Persistent server outage/recovery monitoring. Disabled until explicitly enabled.
SERVER_MONITOR_ENABLED=false
SERVER_MONITOR_INTERVAL_MS=300000
# Requires this many consecutive failed health checks before an offline transition.
SERVER_MONITOR_FAILURE_THRESHOLD=3

# CommandBridge transport. Use http_pull on BinaryLane so the game server
# makes outbound HTTPS requests to Render; no inbound game-server port is opened.
COMMAND_BRIDGE_TRANSPORT=file
# Dedicated Bearer token shared only by the BinaryLane CommandBridge and this
# automation service. Required when COMMAND_BRIDGE_TRANSPORT=http_pull.
BINARYLANE_COMMAND_TOKEN=

# Legacy file bridge / CommandBridge
GAME_FILE_PROTOCOL=ftp
SFTP_HOST=
SFTP_PORT=21
SFTP_USER=
SFTP_PASSWORD=
SFTP_BASE_PATH=/
FTP_SECURE=false
# Keep disabled until this service is deliberately connected to the live server.
COMMAND_BRIDGE_ENABLED=false
# Leave blank until the live Hollow Valley service no longer publishes directly
# to the same commands.ndjson. Then set exactly:
# automation-platform-is-sole-publisher
COMMAND_BRIDGE_SINGLE_PUBLISHER_ACK=
COMMAND_BRIDGE_SAVED_PATH=Mods/CommandBridge/Saved
COMMAND_BRIDGE_TIMEOUT_MS=20000

# BodyDrop automation
BODYDROP_BRIDGE_MODE=commandbridge
BODYDROP_COOLDOWN_SECONDS=900
BODYDROP_UNKNOWN_AFTER_SECONDS=60
BODYDROP_RECONCILE_INTERVAL_MS=300000
# Optional comma-separated overrides: id:name:description:species:growth
BODYDROP_TYPES=

# DinoStorage automation
DINOSTORAGE_RESULT_MODE=bridge_ack
DINOSTORAGE_UNKNOWN_AFTER_SECONDS=60
DINOSTORAGE_RECONCILE_INTERVAL_MS=300000
# Admin restore JSON can be built while this is false. File upload into a
# player's DinoStorage slot remains locked until explicitly enabled.
ADMIN_RESTORE_WRITE_ENABLED=false

# HerbyBot bridge. The automation service queues Discord work; the existing
# HerbyBot polls and delivers it through its one Discord gateway connection.
# Use a dedicated server-to-server token. Do not reuse the admin or website token.
HERBYBOT_AUTOMATION_TOKEN=
HERBYBOT_AUTOMATION_POLL_INTERVAL_MS=300000
HERBYBOT_AUTOMATION_BATCH_SIZE=10
HERBYBOT_AUTOMATION_LEASE_SECONDS=60
HERBYBOT_OUTBOX_MAX_ATTEMPTS=5

# Discord credentials/channel IDs belong on the existing HerbyBot host only.
# The automation service deliberately does not receive DISCORD_BOT_TOKEN.

# Website/API integration.
# HOLLOW_VALLEY_API_TOKEN is shared only between the Hollow Valley backend and
# this automation service. Do not expose it to browser JavaScript and do not
# reuse AUTOMATION_ADMIN_TOKEN.
HOLLOW_VALLEY_API_BASE_URL=https://hollowvalley.herbydeathsquadgames.com
HOLLOW_VALLEY_API_TOKEN=
# Used by the isolated live-site client when it is later copied/wired into the
# Hollow Valley backend. Point it at the separately deployed automation service.
AUTOMATION_SERVICE_URL=
AUTOMATION_SERVICE_TIMEOUT_MS=8000

# HerbyBot publishes Discord scheduled events about once per minute. The website
# keeps the last good snapshot visible and marks it stale after this interval.
DISCORD_EVENTS_STALE_SECONDS=300
