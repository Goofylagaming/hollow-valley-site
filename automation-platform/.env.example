PORT=3100
NODE_ENV=development

# Protect every API that can perform or inspect privileged game actions.
# Use a long random value and store the real secret only in the host's env settings.
AUTOMATION_ADMIN_TOKEN=

# Local automation request ledger (Node 22 built-in SQLite).
# On Render, point this at a persistent disk before production use.
AUTOMATION_DB_PATH=./data/automation.sqlite

# Evrima / RCON (same names as the live Hollow Valley service)
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
RCON_TIMEOUT_MS=6000

# VeryGames file bridge / CommandBridge
GAME_FILE_PROTOCOL=ftp
SFTP_HOST=
SFTP_PORT=21
SFTP_USER=
SFTP_PASSWORD=
SFTP_BASE_PATH=/
FTP_SECURE=false
COMMAND_BRIDGE_ENABLED=true
COMMAND_BRIDGE_SAVED_PATH=Mods/CommandBridge/Saved
COMMAND_BRIDGE_TIMEOUT_MS=20000

# BodyDrop automation
BODYDROP_BRIDGE_MODE=commandbridge
BODYDROP_COOLDOWN_SECONDS=900
BODYDROP_UNKNOWN_AFTER_SECONDS=60
BODYDROP_RECONCILE_INTERVAL_MS=5000
# Optional comma-separated overrides: id:name:description:species:growth
BODYDROP_TYPES=

# DinoStorage (next phase)
DINOSTORAGE_RESULT_MODE=bridge_ack

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Website/API integration
HOLLOW_VALLEY_API_BASE_URL=https://hollowvalley.herbydeathsquadgames.com
HOLLOW_VALLEY_API_TOKEN=
