PORT=3100
NODE_ENV=development

# Protect every API that can perform or inspect privileged game actions.
# Use a long random value and store the real secret only in the host's env settings.
AUTOMATION_ADMIN_TOKEN=

# Local automation request/job/audit/state database (Node 22 built-in SQLite).
# On Render, point this at a persistent disk before production use.
AUTOMATION_DB_PATH=./data/automation.sqlite
# Persisted scheduler checks for due jobs on this cadence.
AUTOMATION_SCHEDULER_INTERVAL_MS=15000

# Optional consistent SQLite snapshots. Leave disabled until persistent storage
# is verified. Restore remains a manual operator procedure.
AUTOMATION_BACKUP_ENABLED=false
AUTOMATION_BACKUP_DIR=./data/backups
AUTOMATION_BACKUP_INTERVAL_MS=21600000
AUTOMATION_BACKUP_RETENTION=20

# Evrima / RCON (same names as the live Hollow Valley service)
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
RCON_TIMEOUT_MS=6000
# Write controls remain disabled until explicitly reviewed and enabled.
RCON_WRITE_ENABLED=false

# Optional read-only player presence/session history. It only closes sessions
# after a successful RCON snapshot shows the player absent; RCON outages do not
# log everyone out.
PLAYER_PRESENCE_ENABLED=false
PLAYER_PRESENCE_INTERVAL_MS=60000
# Aggregate player-count/species samples are retained for trend analytics.
PLAYER_PRESENCE_RETENTION_HOURS=744

# Valley Coin playtime rewards. These are intentionally disabled and set to 0
# until the economy rate has been explicitly chosen. Rewards are credited only
# from successful presence samples; long RCON/offline gaps are not back-paid.
WALLET_PLAYTIME_REWARDS_ENABLED=false
WALLET_PLAYTIME_COINS_PER_5_MINUTES=0
WALLET_PLAYTIME_MAX_SAMPLE_GAP_SECONDS=90

# Automatic verified-playtime quest boosts. Percentages stack additively across
# completed daily/weekly quests and apply only to future 5-minute payouts.
# Leave at 0 until the economy boost values are approved.
ECONOMY_TIMEZONE=Australia/Brisbane
WALLET_QUEST_DAILY_1H_BOOST_PERCENT=0
WALLET_QUEST_DAILY_3H_BOOST_PERCENT=0
WALLET_QUEST_DAILY_6H_BOOST_PERCENT=0
WALLET_QUEST_WEEKLY_12H_BOOST_PERCENT=0
WALLET_QUEST_WEEKLY_24H_BOOST_PERCENT=0
WALLET_QUEST_MAX_TOTAL_BOOST_PERCENT=100

# Optional read-only health history for uptime/player-count analytics.
SERVER_HEALTH_HISTORY_ENABLED=false
SERVER_HEALTH_HISTORY_INTERVAL_MS=60000
SERVER_HEALTH_HISTORY_RETENTION_HOURS=720

# Persistent server outage/recovery monitoring. Disabled until explicitly enabled.
SERVER_MONITOR_ENABLED=false
SERVER_MONITOR_INTERVAL_MS=60000
# Requires this many consecutive failed health checks before an offline transition.
SERVER_MONITOR_FAILURE_THRESHOLD=3

# VeryGames file bridge / CommandBridge
GAME_FILE_PROTOCOL=ftp
SFTP_HOST=
SFTP_PORT=21
SFTP_USER=
SFTP_PASSWORD=
SFTP_BASE_PATH=/
FTP_SECURE=false
# Keep disabled until this service is deliberately connected to the live server.
COMMAND_BRIDGE_ENABLED=false
# Leave blank until the live Hollow Valley service no longer publishes directly
# to the same commands.ndjson. Then set exactly:
# automation-platform-is-sole-publisher
COMMAND_BRIDGE_SINGLE_PUBLISHER_ACK=
COMMAND_BRIDGE_SAVED_PATH=Mods/CommandBridge/Saved
COMMAND_BRIDGE_TIMEOUT_MS=20000

# BodyDrop automation
BODYDROP_BRIDGE_MODE=commandbridge
BODYDROP_COOLDOWN_SECONDS=900
BODYDROP_UNKNOWN_AFTER_SECONDS=60
BODYDROP_RECONCILE_INTERVAL_MS=5000
# Optional comma-separated overrides: id:name:description:species:growth
BODYDROP_TYPES=

# DinoStorage automation
DINOSTORAGE_RESULT_MODE=bridge_ack
DINOSTORAGE_UNKNOWN_AFTER_SECONDS=60
DINOSTORAGE_RECONCILE_INTERVAL_MS=5000
# Admin restore JSON can be built while this is false. File upload into a
# player's DinoStorage slot remains locked until explicitly enabled.
ADMIN_RESTORE_WRITE_ENABLED=false

# HerbyBot bridge. The automation service queues Discord work; the existing
# HerbyBot polls and delivers it through its one Discord gateway connection.
# Use a dedicated server-to-server token. Do not reuse the admin or website token.
HERBYBOT_AUTOMATION_TOKEN=
HERBYBOT_AUTOMATION_POLL_INTERVAL_MS=15000
HERBYBOT_AUTOMATION_BATCH_SIZE=10
HERBYBOT_AUTOMATION_LEASE_SECONDS=60
HERBYBOT_OUTBOX_MAX_ATTEMPTS=5

# Discord credentials/channel IDs belong on the existing HerbyBot host only.
# The automation service deliberately does not receive DISCORD_BOT_TOKEN.

# Website/API integration.
# HOLLOW_VALLEY_API_TOKEN is shared only between the Hollow Valley backend and
# this automation service. Do not expose it to browser JavaScript and do not
# reuse AUTOMATION_ADMIN_TOKEN.
HOLLOW_VALLEY_API_BASE_URL=https://hollowvalley.herbydeathsquadgames.com
HOLLOW_VALLEY_API_TOKEN=
# Used by the isolated live-site client when it is later copied/wired into the
# Hollow Valley backend. Point it at the separately deployed automation service.
AUTOMATION_SERVICE_URL=
AUTOMATION_SERVICE_TIMEOUT_MS=8000
