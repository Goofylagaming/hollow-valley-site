# Copy to .env and fill in real values before running the server.

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the Node process listens on (Nginx/Docker proxy to this).
PORT=3000

# Where the SQLite database file is stored.
DB_PATH=./data/hollowvalley.sqlite

# Discord OAuth2 app credentials. Create an application at
# https://discord.com/developers/applications, add an OAuth2 redirect URI
# matching DISCORD_REDIRECT_URI below, and copy the client id/secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# Steam login (OpenID) — the primary sign-in option for players. Steam has no
# app registration step; you just need your site's own URLs below. Optional:
# STEAM_API_KEY (free at https://steamcommunity.com/dev/apikey) fetches the
# player's real Steam name/avatar — without it, users get a placeholder name
# like "Survivor12345" but login still works fine.
STEAM_RETURN_URL=https://yourdomain.com/auth/steam/callback
STEAM_REALM=https://yourdomain.com/
STEAM_API_KEY=

# Set to "production" when deployed behind HTTPS (Nginx + certbot).
NODE_ENV=production

# Comma-separated Discord user IDs to auto-promote to site admin on login.
# Admins can create free "premium" skins for everyone via /api/skins/premium.
ADMIN_DISCORD_IDS=

# Owner-only email/password login. Set this to the owner's own Steam ID, then
# sign in with Steam and visit /owner-login to choose an email and password.
# The password is stored as a salted scrypt hash in the persistent site database.
OWNER_STEAM_ID=

# Owner-only BinaryLane management. Disabled until separately commissioned.
# Dedicated random 32+ character token, shared only by website backend and
# the SYSTEM management agent on BinaryLane. Never reuse CommandBridge credentials.
HV_MANAGEMENT_ENABLED=0
HV_MANAGEMENT_WRITES_ENABLED=0
HV_MANAGEMENT_AGENT_TOKEN=

# Optional Stripe *read-only restricted* secret for Admin -> Finance, scoped to
# Read: Subscriptions, Customers, Balance and Payouts. This key must be stored
# only in the website service environment, never in browser JS or Git history.
# If blank, Finance falls back to STRIPE_SECRET_KEY (existing supporter key).
# Owner-only access fails closed unless OWNER_STEAM_ID matches the signed-in user.
STRIPE_FINANCE_READ_KEY=

# Stripe secret key for supporter subscription checkout. Leave blank to keep
# checkout disabled (the site clearly tells users it's not configured yet
# instead of faking a purchase). Set this once you have a real Stripe account
# and are ready to accept real payments.
STRIPE_SECRET_KEY=

# Live server status (player count) via RCON. The Isle: Evrima uses a custom
# RCON protocol - these are the same host/port/password shown in your game
# host's "Connection Info" panel (RCON Port, not Game/Query Port).
# NOTE: the host's firewall must allow RCON connections from this server's
# own IP address, or the status will just show as offline/unknown.
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
# Website-to-automation connection. Live game reads and mutations are handled
# by the BinaryLane presence feed + outbound HTTP-pull CommandBridge.
AUTOMATION_SERVICE_URL=
HOLLOW_VALLEY_API_TOKEN=
AUTOMATION_ADMIN_TOKEN=
SERVER_STATUS_POLL_INTERVAL_MS=15000
# Max player slot count shown as "X/MAX online". RCON's srv:details reply
# doesn't reliably include this, so it's set manually here.
MAX_PLAYERS=100

# Optional: "HerbyBot" Discord bot token (same bot used for Discord login,
# if configured). When set, the bot logs in and shows the live player count
# as its Discord presence, and optionally renames a status channel.
# Create/reuse a bot at https://discord.com/developers/applications ->
# Bot tab -> Reset Token. Needs the "bot" scope with no special permissions
# beyond viewing/managing the one status channel (if used).
DISCORD_BOT_TOKEN=
# Body Drop display/settings. Execution is handled by the automation service
# and the BinaryLane CommandBridge agent.
# Cooldown per player, in seconds.
BODYDROP_COOLDOWN_SECONDS=600
# Optional comma-separated list: id:Display name:Description:species:growth
# "species" MUST exactly match a key in the mod's own SPECIES table (see
# main.lua) - e.g. Compsognathus, Dryosaurus, Triceratops, Tyrannosaurus, etc.
# "growth" is 0..1 (defaults to 1 if omitted/invalid).
BODYDROP_TYPES=small:Small body:A small emergency food drop:Compsognathus:1,medium:Medium body:A balanced body drop for a small group:Dryosaurus:1,large:Large body:A larger drop for bigger carnivores or packs:Triceratops:1

# HV-UX03 site changelog: human-written staff development notes can be
# published without this feature flag. Verified LIVE entries require the
# dedicated GitHub Actions -> website release bridge, OFF by default.
SITE_UPDATES_AUTO_RELEASE_ENABLED=false
# Set only on the website backend and as a GitHub Actions repository secret.
# Do not reuse HerbyBot, Stripe, RCON or automation API tokens.
HV_SITE_UPDATES_TOKEN=

# HV-UX04 private player support tickets. Off until staff moderating capacity
# and production backup verification are confirmed. When disabled, existing
# tickets remain readable and admins can review/resolve them.
HV_SUPPORT_TICKETS_ENABLED=false

# HVS Unified desktop diagnostics: independent GET-only credential, OFF by default.
# Use random >=40 chars; MUST NOT reuse HV_MANAGEMENT_AGENT_TOKEN.
HV_DESKTOP_READONLY_ENABLED=0
HV_DESKTOP_READONLY_TOKEN=

# Group Headquarters remains off until authenticated staging verification.
# Preview deployment protections also force read-only access independently.
GROUP_HQ_ENABLED=0
GROUP_HQ_READ_ONLY=0

# Treasury donations remain off pending closure rules, spending and staging.
# The automation service has its own matching enable flag.
GROUP_TREASURY_ENABLED=0
GROUP_TREASURY_READ_ONLY=0
GROUP_TREASURY_SPEND_ENABLED=0
GROUP_TREASURY_TERRITORY_ENABLED=0
GROUP_TREASURY_EVENT_ENABLED=0
# Relationship declarations remain off until authenticated staging review.
GROUP_DIPLOMACY_ENABLED=0
GROUP_DIPLOMACY_READ_ONLY=0
DYNAMIC_CHALLENGES_ENABLED=0
DYNAMIC_CHALLENGES_READ_ONLY=0
DYNAMIC_CHALLENGES_EVENTS_ENABLED=0
# Staff-only template planning. Scheduling/execution and rewards are not enabled.
EVENT_ENGINE_ENABLED=0
EVENT_ENGINE_READ_ONLY=0
# Separately reviewed website schedules; no game execution or Discord posting.
EVENT_ENGINE_SCHEDULES_ENABLED=0
# Optional Steam-bound website signups; never attendance or reward evidence.
EVENT_ENGINE_REGISTRATION_ENABLED=0
# Staff-reviewed website teams only; no attendance, rewards or game actions.
EVENT_ENGINE_TEAMS_ENABLED=0
# Staff-reported outcomes with private official Discord message evidence.
# These reports never authorize payouts or count as automatic game verification.
EVENT_ENGINE_RESULTS_ENABLED=0
EVENT_ENGINE_RESULT_GUILD_ID=
# Dedicated server-only key shared with automation for Territory outcome proofs.
# At least 32 random bytes; leave unset until the full entry flow is reviewed.
GROUP_TREASURY_TERRITORY_PROOF_SECRET=

# Staff-reviewed status incidents: independent public visibility and management.
STATUS_INCIDENTS_ENABLED=0
STATUS_INCIDENTS_MANAGEMENT_ENABLED=0
STATUS_INCIDENTS_PUBLIC_ENABLED=0
STATUS_INCIDENTS_READ_ONLY=0
STATUS_INCIDENTS_EVIDENCE_GUILD_ID=

# Independent source-timestamped Bridge worker observation; never tests commands.
STATUS_COMPONENTS_COLLECTION_ENABLED=0
STATUS_COMPONENTS_PUBLIC_ENABLED=0

# Read cached Live Map source health without exposing positions. Defaults off.
STATUS_COMPONENTS_MAP_ENABLED=0

# Read-only fixed Steam OpenID discovery check; no account linking or API keys.
STATUS_COMPONENTS_STEAM_ENABLED=0
