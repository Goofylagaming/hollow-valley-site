# Copy to .env and fill in real values before running the server.

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the Node process listens on (Nginx/Docker proxy to this).
PORT=3000

# Where the SQLite database file is stored.
DB_PATH=./data/hollowvalley.sqlite

# Discord OAuth2 app credentials. Create an application at
# https://discord.com/developers/applications, add an OAuth2 redirect URI
# matching DISCORD_REDIRECT_URI below, and copy the client id/secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# Steam login (OpenID) — the primary sign-in option for players. Steam has no
# app registration step; you just need your site's own URLs below. Optional:
# STEAM_API_KEY (free at https://steamcommunity.com/dev/apikey) fetches the
# player's real Steam name/avatar — without it, users get a placeholder name
# like "Survivor12345" but login still works fine.
STEAM_RETURN_URL=https://yourdomain.com/auth/steam/callback
STEAM_REALM=https://yourdomain.com/
STEAM_API_KEY=

# Set to "production" when deployed behind HTTPS (Nginx + certbot).
NODE_ENV=production

# Comma-separated Discord user IDs to auto-promote to site admin on login.
# Admins can create free "premium" skins for everyone via /api/skins/premium.
ADMIN_DISCORD_IDS=

# Stripe secret key for supporter subscription checkout. Leave blank to keep
# checkout disabled (the site clearly tells users it's not configured yet
# instead of faking a purchase). Set this once you have a real Stripe account
# and are ready to accept real payments.
STRIPE_SECRET_KEY=

# Live server status (player count) via RCON. The Isle: Evrima uses a custom
# RCON protocol - these are the same host/port/password shown in your game
# host's "Connection Info" panel (RCON Port, not Game/Query Port).
# NOTE: the host's firewall must allow RCON connections from this server's
# own IP address, or the status will just show as offline/unknown.
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
# Prefer the automation service for website status/map reads. When both values
# are set the website will not open its own RCON connection.
AUTOMATION_SERVICE_URL=
HOLLOW_VALLEY_API_TOKEN=
SERVER_STATUS_POLL_INTERVAL_MS=300000
# Enable only after verifying compatible CommandBridge + DinoStorage/BodyDrop
# mods are installed. No RCON syntax or chat-hook impersonation is used.
COMMAND_BRIDGE_ENABLED=false
# Relative to ue4ss, or an absolute FTP/SFTP-visible directory.
COMMAND_BRIDGE_SAVED_PATH=Mods/CommandBridge/Saved
COMMAND_BRIDGE_TIMEOUT_MS=20000
# Keep submod to wait for source:DinoStorage (not deferred completion).
# Opt in to bridge_ack to return HTTP202 on a matching routing ACK; this only
# confirms cmd.flag was queued, NOT storage, deferred kill or restore.
DINOSTORAGE_RESULT_MODE=submod
# commandbridge is the documented token-array protocol. legacy is ONLY for
# the custom HollowValleyBodyDrop mod accepting action:"spawn" NDJSON.
BODYDROP_BRIDGE_MODE=commandbridge
# Max player slot count shown as "X/MAX online". RCON's srv:details reply
# doesn't reliably include this, so it's set manually here.
MAX_PLAYERS=100

# Optional: "HerbyBot" Discord bot token (same bot used for Discord login,
# if configured). When set, the bot logs in and shows the live player count
# as its Discord presence, and optionally renames a status channel.
# Create/reuse a bot at https://discord.com/developers/applications ->
# Bot tab -> Reset Token. Needs the "bot" scope with no special permissions
# beyond viewing/managing the one status channel (if used).
DISCORD_BOT_TOKEN=
# Game server file connection for live bridge (Park / Redeem / Set Prime).
# Use "sftp" when the host provides SFTP/SSH file access, or "ftp" for plain
# FTP hosts like VeryGames if SFTP is not available.
GAME_FILE_PROTOCOL=ftp
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=
# Root folder shown by your game host's SFTP/FTP file manager, e.g. the folder
# containing TheIsle/Binaries/Win64. VeryGames and other hosts use different
# names here, so do not leave this set to the old Qonzer path.
# Use / if TheIsle is directly at the FTP/SFTP root.
SFTP_BASE_PATH=
# Only set true if your FTP host explicitly requires FTPS/TLS.
FTP_SECURE=false

# Legacy Body Drop requests use the same SFTP bridge, and include an HMAC signature
# on each queued job for future-proofing. Note: the current HollowValleyBodyDrop
# main.lua does NOT verify this signature (its config.lua has no secret field),
# so this currently has no effect on the game-server side, but keep it set.
BODYDROP_SHARED_SECRET=
# Legacy Body Drop only; ignored in commandbridge mode.
# Relative to TheIsle/Binaries/Win64/ue4ss; do not prefix with ue4ss again.
# An absolute FTP/SFTP path overrides SFTP_BASE_PATH for Body Drop only.
# The destination folder must already exist. Lua must read this same file;
# its relative path depends on the game process working directory.
BODYDROP_INBOX_PATH=Mods/HollowValleyBodyDrop/Saved/inbox.ndjson
# Cooldown per player, in seconds.
BODYDROP_COOLDOWN_SECONDS=600
# Optional comma-separated list: id:Display name:Description:species:growth
# "species" MUST exactly match a key in the mod's own SPECIES table (see
# main.lua) - e.g. Compsognathus, Dryosaurus, Triceratops, Tyrannosaurus, etc.
# "growth" is 0..1 (defaults to 1 if omitted/invalid).
BODYDROP_TYPES=small:Small body:A small emergency food drop:Compsognathus:1,medium:Medium body:A balanced body drop for a small group:Dryosaurus:1,large:Large body:A larger drop for bigger carnivores or packs:Triceratops:1
